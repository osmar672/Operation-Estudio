# Copia este archivo como .env y agrega tu clave privada de Groq.
GROQ_API_KEY=
# Usa un modelo disponible en tu cuenta de Groq.
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000
# 127.0.0.1 limita el acceso a tu equipo. No lo expongas a Internet sin autenticación y HTTPS.
HOST=127.0.0.1

# Esfuerzo de razonamiento para openai/gpt-oss-120b: low, medium o high
GROQ_REASONING_EFFORT=high
