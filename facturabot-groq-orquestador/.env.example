# Copia este archivo a .env y agrega tu clave privada de Groq.
GROQ_API_KEY=
# Modelo de producción documentado por Groq (puedes cambiarlo por otro modelo activo de tu cuenta).
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000
# 127.0.0.1 limita el acceso a tu equipo. No lo expongas a Internet sin autenticación y HTTPS.
HOST=127.0.0.1
